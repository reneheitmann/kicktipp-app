# Eigenständige nginx-Config für den Dev-Container (siehe Dockerfile.dev) -
# liefert GENAU EINE Version aus, an der Wurzel "/", ohne jeden Bezug zu
# main/beta (andere Domain/Container/IP, eigenes Supabase-Backend). Bewusst
# eine eigene, einfachere Datei statt eine Variante des main/beta-
# nginx.conf.template: dort dreht sich ein Großteil der Struktur um das
# Nebeneinander mehrerer Routen (/beta/-Location, doppelte index.html-
# Blöcke, /(beta/)?-Regex-Präfixe) - für einen einzelnen, isolierten
# Container wäre das nur Ballast.
#
# .template-Datei statt normaler .conf: das offizielle nginx-Image ersetzt
# beim Start automatisch alle ${VAR}-Platzhalter per envsubst (Skript
# 20-envsubst-on-templates.sh, kein eigenes Entrypoint nötig) und schreibt
# das Ergebnis nach /etc/nginx/conf.d/default.conf – dadurch lässt sich der
# Port über die LISTEN_PORT-Umgebungsvariable ändern, ohne den Code/
# Docker-Image anzufassen.
#
# connect-src zeigt auf das eigenständige "Kicktipp Dev"-Supabase-Projekt
# (evbpltahndvboskmflfq) - NICHT auf das gemeinsame main/beta-Projekt
# (rmfvzbmxcwccnezqqnen). script-src/frame-src erlauben ausschließlich
# kicktipp.de für das eingebettete Kicktipp-Widget (siehe
# KicktippWidgetPage.tsx). style-src erlaubt 'unsafe-inline', da die zur
# Laufzeit admin-konfigurierbare Primärfarbe (siehe AppBrandingProvider.tsx)
# per style.setProperty() auf document.documentElement gesetzt wird.
server {
    listen ${LISTEN_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.kicktipp.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://evbpltahndvboskmflfq.supabase.co wss://evbpltahndvboskmflfq.supabase.co; frame-src https://www.kicktipp.de; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    # SPA-Fallback: React Router übernimmt clientseitiges Routing (z. B.
    # /seasons/123), diese Pfade existieren aber nicht als Datei – ohne
    # try_files würde nginx bei jedem Reload/Direktaufruf einer Unterseite
    # einen 404 liefern statt index.html auszuliefern.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html referenziert die aktuell gültigen, inhaltsadressierten
    # Chunk-Dateien (siehe unten) – ohne explizites Cache-Control würde der
    # Browser sie heuristisch cachen und nach einem Deploy (jedes Docker-
    # Image enthält nur die neuesten Chunk-Dateien, alte werden nicht
    # aufgehoben) auf inzwischen gelöschte Chunks verweisen -> 404 beim
    # dynamischen Import. "no-cache" heißt trotz des Namens nicht "nie
    # cachen", sondern "vor Nutzung immer beim Server nachfragen" (per ETag),
    # ein unveränderter Aufruf bleibt dabei weiterhin ein billiger 304er.
    #
    # nginx vererbt add_header NICHT in eine Location, die selbst mindestens
    # ein add_header setzt – deshalb werden die fünf Header hier (und in
    # icon.png/instance-info.json/dem Static-Asset-Block unten) jeweils
    # wiederholt statt sich auf Vererbung vom server{}-Block zu verlassen.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.kicktipp.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://evbpltahndvboskmflfq.supabase.co wss://evbpltahndvboskmflfq.supabase.co; frame-src https://www.kicktipp.de; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    }

    # icon.png ist das statische Default-Favicon (siehe index.html/
    # AppBrandingProvider.tsx) unter fester, nie wechselnder URL – die
    # "immutable, 30 Tage"-Regel unten wäre hier fatal: tauscht sich die
    # Datei aus (neues App-Icon im Code), würden Browser mit warmem Cache
    # bis zu 30 Tage lang weiter das alte Icon zeigen, unabhängig davon, was
    # der Server ausliefert. Muss VOR dem allgemeinen Regex-Block stehen,
    # da nginx Regex-Locations in Datei-Reihenfolge prüft und beim ersten
    # Treffer stoppt.
    location = /icon.png {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.kicktipp.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://evbpltahndvboskmflfq.supabase.co wss://evbpltahndvboskmflfq.supabase.co; frame-src https://www.kicktipp.de; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    }

    # instance-info.json ist die öffentliche Discovery-Datei für die mobile
    # App (siehe scripts/generate-instance-info.mjs, docs/mobile-app.md):
    # enthält nur ohnehin publizierbare Werte (Supabase-URL, publishable
    # Anon-Key), aber ohne CORS-Header blockt die Capacitor-WebView (Origin
    # capacitor://localhost auf iOS, https://localhost auf Android) den
    # Fetch selbst dann, wenn der Server fehlerfrei antwortet - deshalb hier
    # bewusst '*' statt einer festen Origin-Liste.
    location = /instance-info.json {
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.kicktipp.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://evbpltahndvboskmflfq.supabase.co wss://evbpltahndvboskmflfq.supabase.co; frame-src https://www.kicktipp.de; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    }

    location ~* \.(js|css|svg|png|jpg|jpeg|gif|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.kicktipp.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://evbpltahndvboskmflfq.supabase.co wss://evbpltahndvboskmflfq.supabase.co; frame-src https://www.kicktipp.de; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;
    }
}
